# attn — server environment. Copy to `.env` for local development. Never commit `.env`.
# On Render: Dashboard → attn service → Environment → add the same keys.

# ---- Voice (production): OpenAI Realtime over WebRTC. The key stays on the server;
# the browser only ever receives a short-lived client secret.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
# openai (default) | legacy — legacy = Chrome speech + Gemini, kept only for rollback
VOICE_PROVIDER=openai
# Optional tuning
# OPENAI_REALTIME_VAD=semantic          # semantic (default) | server
# OPENAI_REALTIME_TRANSCRIBE=gpt-4o-mini-transcribe   # "off" disables input transcripts (used for logs/UI only)

ASSISTANT_NAME=Andrew

# ---- Legacy voice stack (VOICE_PROVIDER=legacy only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_FOLLOW_UP=1
# ATTN_ASSISTANT_MOCK=1   # dev only: stub interpreter for the legacy path

# attn — server environment. Copy to `.env` for local development. Never commit `.env`.
# On Render: Dashboard → attn service → Environment → add the same keys.

# Required for the voice/AI assistant (server-side only; never sent to the browser).
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
GEMINI_MODEL=gemini-3.8-flash
# Used once per request when the model above answers 429 (quota); set to 0 to disable
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
ASSISTANT_NAME=Andrew
# Set to 0 to skip the second (wording) request per command — halves free-tier quota use; attn then speaks a plain confirmation
# GEMINI_FOLLOW_UP=1

# Dev only: answer with a built-in stub instead of calling Gemini (no key needed)
# ATTN_ASSISTANT_MOCK=1
